*_cache_runtime.json

# Large static GTFS artifact; database bootstrap downloads the current archive
data/stop_times.txt

# JavaScript dependencies. frontend/dist remains tracked until Railway has a
# verified frontend build step.
node_modules/

# Local and remote environment profiles
.env.remote

# Temporary user-provided notes may contain personal or deployment details
docs/temp_doc/

# Personal/runtime documents belong locally and on the Railway volume
static/resume.pdf

# Historical chat is retained locally and may contain copied credentials
docs/CHAT_HISTORY_RAW.md

# Operational handoff and agent Markdown is private/local-only. The only tracked
# Markdown is the root README plus the file-specific OpenSpec exceptions below.
*.md
!/README.md
# Published OpenSpec change: proposal, design, tasks and spec only. Its QA
# contract (verification.md) and all agent notes stay private.
!/openspec/changes/local-db-isolation/proposal.md
!/openspec/changes/local-db-isolation/design.md
!/openspec/changes/local-db-isolation/tasks.md
!/openspec/changes/local-db-isolation/specs/local-db-isolation/spec.md
!/openspec/changes/boc-reporting-pipeline/proposal.md
!/openspec/changes/dagster-orchestration/proposal.md
!/openspec/changes/dagster-railway/proposal.md

# Railway build attestation markers (generated during the Railway build; never committed)
/.bizqlab-build-attestation.json
/backend/transit_api/.bizqlab-build-attestation.json

# Added by ggshield
.cache_ggshield

# dbt build output and logs
/warehouse/target/
/warehouse/logs/
/warehouse/dbt_packages/
# Dagster's local run history, logs and schedule state (make dagster).
/.dagster_home/
