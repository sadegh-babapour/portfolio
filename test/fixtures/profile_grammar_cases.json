    }
   ],
   "expected": {
    "error": {
     "code": "profile_interpolation",
     "key": "A",
     "line": 1
    }
   }
  },
  {
   "name": "bare dollar is literal",
   "bytes": [
    {
     "text": "A=$HOME\nB=a$\n"
    }
   ],
   "expected": {
