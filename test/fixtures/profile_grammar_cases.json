{
 "description": "design.md §4.1 grammar. bytes is a list of segments: text (UTF-8), hex, or repeat/count. Errors report code, key (only when known) and 1-based line.",
 "cases": [
  {
   "name": "basic assignments",
   "bytes": [
    {
     "text": "A_KEY=value\nPG_1=x\n"
    }
   ],
   "expected": {
    "ok": {
     "A_KEY": "value",
     "PG_1": "x"
    }
   }
  },
  {
   "name": "no trailing newline",
   "bytes": [
    {
     "text": "A=1"
    }
   ],
   "expected": {
    "ok": {
     "A": "1"
    }
   }
  },
  {
   "name": "CRLF normalized",
   "bytes": [
    {
     "text": "A=1\r\nB=2\r\n"
    }
   ],
   "expected": {
    "ok": {
     "A": "1",
     "B": "2"
    }
   }
  },
  {
   "name": "lone CR mid-line",
   "bytes": [
    {
     "text": "A=1\rB=2\n"
    }
   ],
   "expected": {
    "error": {
     "code": "profile_lone_cr",
     "key": null,
     "line": 1
    }
   }
  },
  {
   "name": "trailing CR without LF",
   "bytes": [
    {
     "text": "A=1\nB=2\r"
    }
   ],
   "expected": {
    "error": {
     "code": "profile_lone_cr",
     "key": null,
     "line": 2
    }
   }
  },
  {
   "name": "CR CR LF",
   "bytes": [
    {
     "text": "A=1\r\r\n"
    }
   ],
   "expected": {
    "error": {
     "code": "profile_lone_cr",
     "key": null,
     "line": 1
    }
   }
  },
  {
   "name": "blank, whitespace and comment lines",
   "bytes": [
    {
     "text": "\n \t\n# c\n  # indented\n\t#tab\nA=1\n\n"
    }
   ],
   "expected": {
    "ok": {
     "A": "1"
    }
   }
  },
  {
   "name": "only comments",
   "bytes": [
    {
     "text": "# nothing\n"
    }
   ],
   "expected": {
    "ok": {}
   }
  },
  {
   "name": "empty file",
   "bytes": [],
   "expected": {
    "error": {
     "code": "profile_empty",
     "key": null,
     "line": null
    }
   }
  },
  {
   "name": "BOM",
   "bytes": [
    {
     "hex": "efbbbf"
    },
    {
     "text": "A=1\n"
    }
   ],
   "expected": {
    "error": {
     "code": "profile_bom",
     "key": null,
     "line": 1
    }
   }
  },
  {
   "name": "export prefix",
   "bytes": [
    {
     "text": "A=1\nexport B=2\n"
    }
   ],
   "expected": {
    "error": {
     "code": "profile_export",
     "key": null,
     "line": 2
    }
   }
  },
  {
   "name": "export with tab",
   "bytes": [
    {
     "text": "export\tB=2\n"
    }
   ],
   "expected": {
    "error": {
     "code": "profile_export",
     "key": null,
     "line": 1
    }
   }
  },
  {
   "name": "lowercase export key is just an invalid key",
   "bytes": [
    {
     "text": "export=1\n"
    }
   ],
   "expected": {
    "error": {
     "code": "profile_invalid_key",
     "key": null,
     "line": 1
    }
   }
  },
  {
   "name": "uppercase EXPORT is a normal key",
   "bytes": [
    {
     "text": "EXPORT=1\n"
    }
   ],
   "expected": {
    "ok": {
     "EXPORT": "1"
    }
   }
  },
  {
   "name": "space before equals",
   "bytes": [
    {
     "text": "A =1\n"
    }
   ],
   "expected": {
    "error": {
     "code": "profile_space_around_equals",
     "key": null,
     "line": 1
    }
   }
  },
  {
   "name": "space after equals",
   "bytes": [
    {
     "text": "A= 1\n"
    }
   ],
   "expected": {
    "error": {
     "code": "profile_space_around_equals",
     "key": "A",
     "line": 1
    }
   }
  },
  {
   "name": "tab after equals",
   "bytes": [
    {
     "text": "A=\t1\n"
    }
   ],
   "expected": {
    "error": {
     "code": "profile_space_around_equals",
     "key": "A",
     "line": 1
    }
   }
  },
  {
   "name": "spaces both sides",
   "bytes": [
    {
     "text": "A = 1\n"
    }
   ],
   "expected": {
    "error": {
     "code": "profile_space_around_equals",
     "key": null,
     "line": 1
    }
   }
  },
  {
   "name": "lowercase key",
   "bytes": [
    {
     "text": "a=1\n"
    }
   ],
   "expected": {
    "error": {
     "code": "profile_invalid_key",
     "key": null,
     "line": 1
    }
   }
  },
  {
   "name": "leading digit key",
   "bytes": [
    {
     "text": "1A=1\n"
    }
   ],
   "expected": {
    "error": {
     "code": "profile_invalid_key",
     "key": null,
     "line": 1
    }
   }
  },
  {
   "name": "dash in key",
   "bytes": [
    {
     "text": "A-B=1\n"
    }
   ],
   "expected": {
    "error": {
     "code": "profile_invalid_key",
     "key": null,
     "line": 1
    }
   }
  },
  {
   "name": "empty key",
   "bytes": [
    {
     "text": "=1\n"
    }
   ],
   "expected": {
    "error": {
     "code": "profile_invalid_key",
     "key": null,
     "line": 1
    }
   }
  },
  {
   "name": "leading whitespace",
   "bytes": [
    {
     "text": " A=1\n"
    }
   ],
   "expected": {
    "error": {
     "code": "profile_leading_whitespace",
     "key": null,
     "line": 1
    }
   }
  },
  {
   "name": "missing equals",
   "bytes": [
    {
     "text": "A\n"
    }
   ],
   "expected": {
    "error": {
     "code": "profile_missing_equals",
     "key": null,
     "line": 1
    }
   }
  },
  {
   "name": "double-quoted value may contain space-hash",
   "bytes": [
    {
     "text": "A=\"x #y\"\n"
    }
   ],
   "expected": {
    "ok": {
     "A": "x #y"
    }
   }
  },
  {
   "name": "single-quoted value may contain space-hash",
   "bytes": [
    {
     "text": "A='x #y'\n"
    }
   ],
   "expected": {
    "ok": {
     "A": "x #y"
    }
   }
  },
  {
   "name": "unquoted space-hash rejected",
   "bytes": [
    {
     "text": "A=x #y\n"
    }
   ],
   "expected": {
    "error": {
     "code": "profile_unquoted_hash",
     "key": "A",
     "line": 1
    }
   }
  },
  {
   "name": "unquoted tab-hash permitted (only space-hash is ambiguous)",
   "bytes": [
    {
     "text": "A=x\t#y\n"
    }
   ],
   "expected": {
    "ok": {
     "A": "x\t#y"
    }
   }
  },
  {
   "name": "Sol B3 input: PGPASSWORD tab-hash",
   "bytes": [
    {
     "text": "PGPASSWORD=x\t#y\n"
    }
   ],
   "expected": {
    "ok": {
     "PGPASSWORD": "x\t#y"
    }
   }
  },
  {
   "name": "tab-hash then space-hash is still rejected",
   "bytes": [
    {
     "text": "A=x\t#y #z\n"
    }
   ],
   "expected": {
    "error": {
     "code": "profile_unquoted_hash",
     "key": "A",
     "line": 1
    }
   }
  },
  {
   "name": "tab then space-hash is rejected",
   "bytes": [
    {
     "text": "A=x\t #y\n"
    }
   ],
   "expected": {
    "error": {
     "code": "profile_unquoted_hash",
     "key": "A",
     "line": 1
    }
   }
  },
  {
   "name": "leading tab-hash is whitespace after equals",
   "bytes": [
    {
     "text": "A=\t#y\n"
    }
   ],
   "expected": {
    "error": {
     "code": "profile_space_around_equals",
     "key": "A",
     "line": 1
    }
   }
  },
  {
   "name": "unquoted hash without whitespace",
   "bytes": [
    {
     "text": "A=x#y\nB=#z\n"
    }
   ],
   "expected": {
    "ok": {
     "A": "x#y",
     "B": "#z"
    }
   }
  },
  {
   "name": "empty double-quoted",
   "bytes": [
    {
     "text": "A=\"\"\n"
    }
   ],
   "expected": {
    "ok": {
     "A": ""
    }
   }
  },
  {
   "name": "empty single-quoted",
   "bytes": [
    {
     "text": "A=''\n"
    }
   ],
   "expected": {
    "ok": {
     "A": ""
    }
   }
  },
  {
   "name": "empty unquoted",
   "bytes": [
    {
     "text": "A=\n"
    }
   ],
   "expected": {
    "ok": {
     "A": ""
    }
   }
  },
  {
   "name": "mixed quotes: apostrophe in double",
   "bytes": [
    {
     "text": "A=\"it's\"\n"
    }
   ],
   "expected": {
    "ok": {
     "A": "it's"
    }
   }
  },
  {
   "name": "mixed quotes: double in single",
   "bytes": [
    {
     "text": "A='say \"hi\"'\n"
    }
   ],
   "expected": {
    "ok": {
     "A": "say \"hi\""
    }
   }
  },
  {
   "name": "mismatched quote pair",
   "bytes": [
    {
     "text": "A=\"x'\n"
    }
   ],
   "expected": {
    "error": {
     "code": "profile_mismatched_quotes",
     "key": "A",
     "line": 1
    }
   }
  },
  {
   "name": "unterminated double",
   "bytes": [
    {
     "text": "A=\"abc\n"
    }
   ],
   "expected": {
    "error": {
     "code": "profile_mismatched_quotes",
     "key": "A",
     "line": 1
    }
   }
  },
  {
   "name": "single quote character only",
   "bytes": [
    {
     "text": "A=\"\n"
    }
   ],
   "expected": {
    "error": {
     "code": "profile_mismatched_quotes",
     "key": "A",
     "line": 1
    }
   }
  },
  {
   "name": "unquoted ending in quote",
   "bytes": [
    {
     "text": "A=abc\"\n"
    }
   ],
   "expected": {
    "error": {
     "code": "profile_mismatched_quotes",
     "key": "A",
     "line": 1
    }
   }
  },
  {
   "name": "inner quote of the same kind",
   "bytes": [
    {
     "text": "A=\"a\"b\"\n"
    }
   ],
   "expected": {
    "error": {
     "code": "profile_mismatched_quotes",
     "key": "A",
     "line": 1
    }
   }
  },
  {
   "name": "text after closing quote",
   "bytes": [
    {
     "text": "A=\"abc\" \n"
    }
   ],
   "expected": {
    "error": {
     "code": "profile_mismatched_quotes",
     "key": "A",
     "line": 1
    }
   }
  },
  {
   "name": "unquoted trailing space",
   "bytes": [
    {
     "text": "A=abc \n"
    }
   ],
   "expected": {
    "error": {
     "code": "profile_trailing_whitespace",
     "key": "A",
     "line": 1
    }
   }
  },
  {
   "name": "unquoted trailing tab",
   "bytes": [
    {
     "text": "A=abc\t\n"
    }
   ],
   "expected": {
    "error": {
     "code": "profile_trailing_whitespace",
     "key": "A",
     "line": 1
    }
   }
  },
  {
   "name": "interpolation unquoted",
   "bytes": [
    {
     "text": "A=${HOME}\n"
    }
   ],
   "expected": {
    "error": {
     "code": "profile_interpolation",
     "key": "A",
     "line": 1
    }
   }
  },
  {
   "name": "interpolation double-quoted",
   "bytes": [
