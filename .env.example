APP_ENV=local
RESUME_PDF_PATH=static/resume.pdf

# Portfolio/contact database. Railway should supply a service reference. Set a
# local connection string only in an ignored environment profile.
DATABASE_URL=

# Contact page public URL and secrets. Generate both keys with:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
CONTACT_PUBLIC_BASE_URL=http://localhost:8086
CONTACT_ALLOWED_ORIGINS=http://localhost:8086
CONTACT_TOKEN_PEPPER=
CONTACT_IP_HASH_KEY=

# Cloudflare Turnstile. Use Cloudflare's documented test keys locally and a
# hostname-restricted Managed widget for bizqlab.com in production.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_EXPECTED_HOSTNAMES=localhost

# Resend HTTPS transactional-email settings. The verified visitor is Reply-To,
# never the sender.
CONTACT_FROM_EMAIL=portfolio@bizqlab.com
CONTACT_TO_EMAIL=
RESEND_API_KEY=

# Google OpenID Connect and server-side session settings. Authentication stays
# disabled until the client credentials are configured.
AUTH_PUBLIC_BASE_URL=http://localhost:8086
GOOGLE_OIDC_CLIENT_ID=
GOOGLE_OIDC_CLIENT_SECRET=
AUTH_ADMIN_GOOGLE_SUBJECTS=
AUTH_ADMIN_EMAILS=
AUTH_SESSION_TTL_HOURS=12
AUTH_LOGIN_STATE_TTL_MINUTES=10
AUTH_EVENT_RETENTION_DAYS=90

# Anonymous allow-listed page-render counts. No visitor identifiers are stored.
ANALYTICS_RETENTION_DAYS=90

PGHOST=localhost
PGPORT=5432
PGDATABASE=transit_local
PGUSER=postgres
PGPASSWORD=

TRANSIT_API_PORT=4000
VITE_TRANSIT_API_BASE_URL=http://localhost:4000/api

POLL_INTERVAL_SECONDS=30
POLL_ENABLED=true
POLL_START_HOUR=8
POLL_END_HOUR=21
POLL_TIMEZONE=America/Edmonton
ADMIN_KILL_SWITCH=false
RAW_RETENTION_MINUTES=15
