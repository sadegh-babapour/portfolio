    }
   }
  },
  {
   "name": "tab inside value allowed",
   "bytes": [
    {
     "text": "A=a\tb\n"
    }
   ],
   "expected": {
    "ok": {
     "A": "a\tb"
    }
   }
  },
  {
   "name": "SOH control char",
   "bytes": [
    {
     "text": "A=1\nB=a"
    },
    {
     "hex": "01"
    },
    {
     "text": "b\n"
    }
   ],
